---
import Layout from "../layouts/Layout.astro";
---

<Layout title="about — austin" description="a little more about austin">
  <div class="min-h-screen bg-paper text-ink">
    <main
      class="mx-auto flex min-h-dvh max-w-6xl flex-col px-6 py-8 text-base sm:px-8 lg:px-12"
    >
      <nav class="flex justify-between font-mono text-xs tracking-wide">
        <a
          href="/"
          aria-label="back to home"
          class="quiet-link font-mono text-xs tracking-wide"
        >
          tin / about
        </a>
      </nav>

      <section class="flex-1 pt-14" aria-labelledby="about-heading">
        <h1
          id="about-heading"
          class="text-5xl font-semibold leading-none tracking-tight sm:text-6xl"
        >
          about
        </h1>
      </section>

      <footer
        class="flex flex-wrap justify-between gap-2 pt-8 font-mono text-xs tracking-wide text-muted"
      >
        <span>© {new Date().getFullYear()} austin</span>
        <span>end</span>
      </footer>
    </main>
  </div>
</Layout>
